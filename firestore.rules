rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /test/{docId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /characters/{characterId} {
      allow read, write: if true;
    }

    match /user_characters/{itemId} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /wallet_transactions/{txId} {
      allow read, write: if true;
    }

    match /redeem_codes/{codeId} {
      allow read, write: if true;
    }

    match /code_redemptions/{redemptionId} {
      allow read, write: if true;
    }

    match /quests/{questId} {
      allow read, write: if true;
    }

    match /user_quests/{uqId} {
      allow read, write: if true;
    }

    match /special_orders/{orderId} {
      allow read, write: if true;
    }

    match /user_loyalty_cards/{cardId} {
      allow read, write: if true;
    }

    match /loyalty_logs/{logId} {
      allow read, write: if true;
    }

    match /vouchers/{voucherId} {
      allow read, write: if true;
    }

    match /user_vouchers/{uvId} {
      allow read, write: if true;
    }

    match /feedbacks/{feedbackId} {
      allow read, write: if true;
    }

    match /complaints/{complaintId} {
      allow read, write: if true;
    }

    match /character_feedbacks/{commentId} {
      allow read, write: if true;
    }

    match /admin_audit_logs/{logId} {
      allow read, write: if true;
    }

    match /cat_town_profiles/{userId} {
      allow read, write: if true;
    }

    match /spices/{spiceId} {
      allow read, write: if true;
    }

    match /admin_todos/{todoId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
